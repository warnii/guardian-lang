app GuardianDemo

    # ── Basic output ─────────────────────────────────
    say "Guardian Programming Language v1.0"
    say "Secure by Design. Safe by Default."
    say ""

    # ── Variables & arithmetic ────────────────────────
    set x to 10
    set y to 3
    say "x + y = " + (x + y)
    say "x * y = " + (x * y)
    say "x ** y = " + (x ** y)
    say ""

    # ── Natural comparisons ───────────────────────────
    if x is greater than y
        say "x is greater than y"
    otherwise
        say "y is greater than x"

    # ── Functions ─────────────────────────────────────
    say ""
    define greet for name
        give back "Hello, " + name + "!"

    say greet("Guardian")
    say greet("Warnii")

    # ── Recursion ─────────────────────────────────────
    define factorial for n
        if n is at most 1
            give back 1
        give back n * factorial(n - 1)

    say ""
    say "5! = " + factorial(5)
    say "8! = " + factorial(8)

    # ── Lists ─────────────────────────────────────────
    say ""
    set fruits to list("mango", "apple", "banana", "grape")
    say "Fruits:"
    for each fruit in fruits
        say "  " + fruit

    # ── String built-ins ──────────────────────────────
    say ""
    set lang to "guardian"
    say upper(lang)
    say length(lang)
    say contains(lang, "guard")

