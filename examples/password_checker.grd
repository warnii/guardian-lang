app PasswordChecker

    say "=== Guardian Password Strength Checker ==="
    say ""

    define check_password for pwd
        set score to 0
        set feedback to list()

        if length(pwd) is at least 8
            set score to score + 1
        otherwise
            set feedback to add_to(feedback, "Too short — need 8+ characters")

        if length(pwd) is at least 12
            set score to score + 1

        if contains(pwd, "0") or contains(pwd, "1") or contains(pwd, "2") or contains(pwd, "3")
            set score to score + 1
        otherwise
            set feedback to add_to(feedback, "Add numbers for strength")

        if length(pwd) is at most 6
            set feedback to add_to(feedback, "Much too short")

        give back score

    set pwd to ask "Enter a password to check: "
    set score to check_password(pwd)

    say ""
    if score is at least 3
        say "Strong password!"
    otherwise if score is at least 2
        say "Medium strength — consider making it longer"
    otherwise
        say "Weak password — make it longer and add numbers"

    say "Score: {score}/3"
